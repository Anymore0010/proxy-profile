# Spotify去广告  —— 由 vendor/loon-plugins/Spotify_remove_ads.lpx 自动转换（tools/convert-plugins.mjs）
# 源插件: https://kelee.one/Tool/Loon/Lpx/Spotify_remove_ads.lpx
# 请勿手工编辑：改源插件后重新运行 bun tools/fetch-plugins.mjs && bun tools/convert-plugins.mjs

^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\/ url reject-dict
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service) url script-response-body https://raw.githubusercontent.com/Anymore0010/proxy-profile/master/snapshot/host/kelee.one/Resource/JavaScript/Spotify/Spotify_remove_ads.js

hostname = *-spclient.spotify.com, spclient.wg.spotify.com
