# 知乎去广告  —— 由 vendor/loon-plugins/Zhihu_remove_ads.lpx 自动转换（tools/convert-plugins.mjs）
# 源插件: https://kelee.one/Tool/Loon/Lpx/Zhihu_remove_ads.lpx
# 请勿手工编辑：改源插件后重新运行 bun tools/fetch-plugins.mjs && bun tools/convert-plugins.mjs

^https:\/\/m-cloud\.zhihu\.com\/api\/cloud\/zhihu\/config\/all\? url jsonjq-response-body 'def drop_keys: {"km_httpdns_new_config_tars":true,"preFetchHttpDns":true,"httpdns_detector_use_concurrent":true,"httpdns_use_memory_cache":true,"httpdns_new_config_tars":true,"coreNetworkConf_useTars":true,"km_coreNetworkConf_useTars":true,"sugarQuicConfig":true,"quic_dns_detect_enable":true,"quicMixAB":true,"quic_downgrade_enable":true,"quic_priority_strategy":true,"quic_check_health_enable":true,"tquic_configuration":true,"networkExprimentList":true,"tars_ab_list":true,"zaSetExtraRequestHeader":true}; .data.configs |= map(select((drop_keys[.configKey] // false) | not) | if (.configValue | type) == "object" then del(.configValue.delayHttpdns, .configValue.dnsParser, .configValue.HTTPDNS) else . end)'
^https:\/\/api\.zhihu\.com\/commercial_api\/ url reject-dict
^https:\/\/api\.zhihu\.com\/root\/tab\/v\d(?:\?.+)?$ url jsonjq-response-body '.tab_list |= map(select(.tab_type == "follow" or .tab_type == "recommend" or .tab_type == "hot" or .tab_type == "ring_tab"))'
^https:\/\/api\.zhihu\.com\/topstory\/recommend\? url jsonjq-response-body '.data |= map(select(.type == "ComponentCard"))'
^https:\/\/api\.zhihu\.com\/questions\/\d+\/feeds\? url jsonjq-response-body 'del(.ad_info)'
^https:\/\/api\.zhihu\.com\/next-render\?id=\d+&type=answer url reject-dict
^https:\/\/api\.zhihu\.com\/comment_v\d\/(answers|pins)\/\d+\/root_comment\? url jsonjq-response-body 'del(.atmosphere_voting_config)'
^https:\/\/(api|page-info)(?:\.zhihu)?\.com\/answers\/v\d\/\d+(?:\?.*)?$ url jsonjq-response-body 'del(.third_business, .float_search_word)'
^https:\/\/(api|page-info)(?:\.zhihu)?\.com\/answers\/v\d\/\d+(?:\?.*)?$ url jsonjq-response-body '.structured_content.segments |= map(select(.type != "card"))'
^https:\/\/api\.zhihu\.com\/topstory\/recommend\? url jsonjq-response-body '.data[]?.children |= (if type == "array" then map(select(.id != "ring")) else . end)'
^https:\/\/api\.zhihu\.com\/(articles|answers|pins)\/v\d\/\d+\? url jsonjq-response-body 'del(.third_business, .ring_info, .interaction_bar_plugins)'
^https:\/\/api\.zhihu\.com\/comment_v\d\/answers\/\d+\/list-headers$ url jsonjq-response-body 'del(.continuous_consumption_module)'
^https:\/\/api\.zhihu\.com\/podcasts\/hub\/v\d$ url jsonjq-response-body 'del(.banners)'
^https:\/\/api\.zhihu\.com\/search\/preset_words\? url reject-dict
^https:\/\/api\.zhihu\.com\/search\/related_queries\/question\/\d+$ url reject-dict
^https:\/\/api\.zhihu\.com\/search\/recommend_query\/v\d\? url jsonjq-response-body '.recommend_queries.queries |= map(select(.type == "normal"))'
^https:\/\/api\.zhihu\.com\/search_v\d\? url jsonjq-response-body 'del(.pendant)'
^https:\/\/api\.zhihu\.com\/search\/tabs\? url jsonjq-response-body '.data |= map(select(.t | IN("general", "ai_zhida", "recent", "people", "zvideo", "ring", "topic", "podcast", "column", "pin", "favlist")))'
^https:\/\/zhida\.zhihu\.com\/ai_ingress\/knowledge\/square\/categories\/feeds\?categoryId=1%7D$ url reject-dict
^https:\/\/zhida\.zhihu\.com\/ai_ingress\/ai_chat\/guidance$ url reject-dict
^https:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/show$ url reject-dict
^https:\/\/www\.zhihu\.com\/api\/v\d\/members\/homepage_card$ url reject-dict
^https:\/\/api\.zhihu\.com\/people\/homepage_entry_v\d$ url reject-dict
^https:\/\/api\.zhihu\.com\/kvip\/right\/my_card\? url reject-dict
^https:\/\/api\.zhihu\.com\/people\/self$ url jsonjq-response-body 'del(.vip_info.entrance_new.right_button, .vip_info.entrance_v2)'
^https:\/\/api\.zhihu\.com\/unlimited\/go\/my_card\/v\d\? url reject-dict

hostname = m-cloud.zhihu.com, api.zhihu.com, www.zhihu.com, page-info.zhihu.com, zhida.zhihu.com
